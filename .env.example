# Environment Variables Example for NERIXA NER-Shield AI

# Weather Intelligence APIs (Stormglass & OpenWeather)
STORMGLASS_API_KEY=
OPENWEATHER_API_KEY=
NEXT_PUBLIC_STORMGLASS_API_KEY=
